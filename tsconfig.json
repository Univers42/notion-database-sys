{
  // Root-only compile target ("Typecheck root" in CI). Packages have their
  // own tsconfig.json extending tsconfig.base.json directly, NOT this file —
  // this file's "exclude" deliberately keeps "packages" out of the root scan
  // (each package is typechecked independently via `turbo run typecheck`),
  // and that exclude pattern would otherwise be inherited (and rebased) into
  // every package/*/tsconfig.json if they extended this file instead.
  "extends": "./tsconfig.base.json",
  "exclude": [
    "node_modules",
    "dist",
    "**/build/**",
    "**/pkg/**",
    "src/lib/engine/**/pkg",
    "vendor/scripts",
    "packages"
  ]
}
